{
  "name": "head-gui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "dev:remote": "cross-env VITE_REMOTE=1 vite --host",
    "dev:pi": "cross-env VITE_NO_WATCH=1 vite",
    "dev:remote:pi": "cross-env VITE_NO_WATCH=1 VITE_REMOTE=1 vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron . --no-sandbox",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron:dev:pi": "concurrently \"npm run dev:pi\" \"npm run electron\"",
    "electron:dev:remote:pi": "concurrently \"npm run dev:remote:pi\" \"npm run electron\"",
    "electron:build": "npm run build && electron-builder",
    "bridge": "node serial-ws-bridge/index.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.4",
    "@react-three/fiber": "^8.16.2",
    "clsx": "^2.1.1",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.564.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tailwind-merge": "^3.4.0",
    "three": "^0.163.0",
    "urdf-loader": "^0.12.3",
    "zustand": "^4.5.2",
    "serialport": "^12.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/node": "^20.12.7",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^8.2.2",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "electron-store": "^8.2.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "^5.4.5",
    "vite": "^5.2.10",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.botforge.headgui",
    "productName": "HeadGUI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "afterPack": "./build/afterPack.cjs"
  }
}