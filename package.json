{
  "name": "head-gui",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=14.19.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:remote": "vite --host",
    "dev:pi": "cross-env VITE_NO_WATCH=1 vite",
    "dev:remote:pi": "cross-env VITE_NO_WATCH=1 vite --host",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "electron": "wait-on tcp:5173 && cross-env NODE_ENV=development electron . --no-sandbox",
    "electron:dev": "concurrently \"npm run dev\" \"npm run electron\"",
    "electron:build": "npm run build && electron-builder"
  },
  "dependencies": {
    "@react-three/drei": "^9.105.4",
    "@react-three/fiber": "^8.16.2",
    "@serialport/parser-readline": "^11.0.0",
    "clsx": "^2.1.1",
    "cross-env": "^7.0.3",
    "framer-motion": "^11.11.0",
    "lucide-react": "^0.294.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "serialport": "^11.0.0",
    "tailwind-merge": "^2.2.0",
    "three": "^0.163.0",
    "urdf-loader": "^0.12.3",
    "zustand": "^4.5.2"
  },
  "devDependencies": {
    "@types/node": "^14.18.0",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "@types/three": "^0.163.0",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "concurrently": "^7.6.0",
    "electron": "^22.3.27",
    "electron-builder": "^24.6.4",
    "electron-store": "^8.1.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "typescript": "~4.9.5",
    "vite": "^4.5.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.botforge.headgui",
    "productName": "HeadGUI",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "linux": {
      "target": "AppImage",
      "category": "Utility",
      "executableArgs": [
        "--no-sandbox"
      ]
    },
    "win": {
      "target": "nsis"
    },
    "afterPack": "./build/afterPack.cjs"
  }
}
